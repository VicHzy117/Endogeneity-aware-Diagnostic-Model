# macOS
.DS_Store
._*

# R session / history
.Rhistory
.RData
.Ruserdata

# Large generated objects
*.rds
*.RData
*.RDataTmp

# The conventional-CDM benchmark is intentionally versioned.  It is the
# unchanged baseline from the original comparison and is not regenerated.
!compare_to_conventional_cdm/baseline/conventional/*.rds

# Logs
log/
logs/
*.log
slurm-*.out
*.out
*.err

# Generated large result folders
**/data/generated/
**/result/fits/
**/result/bic_fits/
**/result/eacdm/
**/output/chains/
**/tmp/

# Keep placeholders if present
!**/.gitkeep

# Local plotting scratch
Rplots.pdf
